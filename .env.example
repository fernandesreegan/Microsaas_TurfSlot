# TurfSlot environment variables
# - Local (host) development: copy to backend/.env (the API reads backend/.env).
# - Docker Compose: copy to .env at the repo root (used via env_file by the api service).
#   Compose overrides DATABASE_URL / SMTP_HOST / FRONTEND_URL to point at the containers.

# Database (dev Postgres from docker-compose.dev.yml is published on host port 5433)
DATABASE_URL=postgresql://turfslot:turfslot@localhost:5433/turfslot
TEST_DATABASE_URL=postgresql://turfslot:turfslot@localhost:5433/turfslot_test

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Booking rules
BOOKING_HOLD_MINUTES=10
MAX_SLOTS_PER_BOOKING=4
BOOKING_WINDOW_DAYS=30
FREE_CANCELLATION_HOURS=24
DEFAULT_CURRENCY=INR
SCHEDULER_ENABLED=true

# Dodo Payments
# DODO_PAYMENTS_API_KEY=fake (or empty) uses the in-process FakePaymentGateway.
DODO_PAYMENTS_API_KEY=fake
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_BOOKING_PRODUCT_ID=your-pay-what-you-want-product-id

# OpenAI (placeholder - not used by the current TurfSlot code yet)
OPENAI_API_KEY=your-openai-api-key

# Email (SMTP; Mailpit in dev - UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TurfSlot <no-reply@turfslot.local>

# URLs
FRONTEND_URL=http://localhost:5173

# Rate limiting / logging
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# Frontend (Vite; build-time)
VITE_API_URL=http://localhost:8000
VITE_MAX_SLOTS_PER_BOOKING=4

# Google Sign-In (OAuth 2.0 Web client ID; leave empty to disable)
GOOGLE_CLIENT_ID=
